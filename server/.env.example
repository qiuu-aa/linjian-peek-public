# 掌心窗 server 配置
# 生成 token 示例：python3 - <<'PY'
# import secrets; print(secrets.token_urlsafe(32))
# PY
LINJIAN_TOKEN=please-change-me-to-a-long-random-token
LINJIAN_URL=http://127.0.0.1:8513
LINJIAN_HOST=127.0.0.1
LINJIAN_PORT=8513
LINJIAN_DATA_DIR=./data
LINJIAN_KEEP=3
LINJIAN_HOOK=
# 优先：使用 Slack User OAuth Token，以授权用户身份发送（敏感凭据）。
SLACK_USER_TOKEN=
# 回退：未配置用户令牌时，使用 Slack Bot Token。
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# 兼容旧部署：API 令牌与频道 ID 未完整配置时，才使用 Incoming Webhook。
SLACK_WEBHOOK_URL=
# 只合并频繁的 app_open/foreground_changed；其他手机事件仍立即发送。
SLACK_EVENT_DEBOUNCE_SECONDS=45
SLACK_EVENT_MIN_INTERVAL_SECONDS=120
# 深夜提醒由 Android 端按 10/30/60 分钟及之后每 30 分钟逐级产生；
# server 只即时转发，发送失败不会积压或在网络恢复后补发旧提醒。
